{
  "registryName": "containers",
  "k8sName": "containers",
  "imageRepo": "containers",
  "port": 8089,
  "forward_auth": true,
  "description": "Container image registry management",
  "registryAccount": false,
  "infra": {},
  "derivedSecrets": [],
  "requiredConfig": [
    "REGISTRY_URL"
  ],
  "optionalConfig": [
    "REGISTRY_USERNAME",
    "REGISTRY_PASSWORD"
  ],
  "secretConfig": [
    "REGISTRY_PASSWORD"
  ],
  "envExtras": {
    "GITEA_INTEGRATION_URL": "http://${PREFIX}-gitea-integration:8088"
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/repositories",
      "action": "listRepository",
      "resource": "containers/repositories"
    },
    {
      "method": "GET",
      "path": "/repositories/{namespace}/{image}/tags",
      "action": "listTag",
      "resource": "containers/repositories/{namespace}/{image}"
    },
    {
      "method": "GET",
      "path": "/repositories/{namespace}/{image}/manifests/{reference}",
      "action": "getManifest",
      "resource": "containers/repositories/{namespace}/{image}"
    },
    {
      "method": "DELETE",
      "path": "/repositories/{namespace}/{image}/manifests/{digest}",
      "action": "deleteManifest",
      "resource": "containers/repositories/{namespace}/{image}"
    }
  ],
  "actions": [],
  "default_grants": [
    {
      "grant_on": "user",
      "actions": [
        "listRepository",
        "listTag",
        "getManifest"
      ],
      "resources": [
        "{username}/containers/repositories",
        "{username}/containers/repositories/*"
      ]
    }
  ]
}
