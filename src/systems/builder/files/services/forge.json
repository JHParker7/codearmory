{
  "registryName": "forge",
  "k8sName": "forge",
  "imageRepo": "forge",
  "port": 8083,
  "forward_auth": true,
  "description": "Sandboxed code execution",
  "registryAccount": false,
  "infra": {
    "egressProxy": true,
    "networkPolicy": true,
    "forgeExecRBAC": true
  },
  "derivedSecrets": [
    {
      "envVar": "GITEA_INTERNAL_KEY",
      "kind": "shared",
      "name": "gitea-internal-key"
    }
  ],
  "requiredConfig": [
    "DATABASE_URL"
  ],
  "optionalConfig": [
    "RUNTIME",
    "ALLOWED_IMAGES",
    "K8S_RUNTIME_CLASS",
    "EGRESS_PROXY_ENABLED"
  ],
  "secretConfig": [
    "DATABASE_URL"
  ],
  "envExtras": {
    "RUNTIME": "kubernetes",
    "ALLOWED_IMAGES": "alpine:3.19,ubuntu:22.04,python:3.12-slim,golang:1.25",
    "K8S_NAMESPACE": "${NAMESPACE}",
    "CONTAINER_MEMORY_LIMIT": "256Mi",
    "CONTAINER_CPU_LIMIT": "500m",
    "GITEA_INTERNAL_URL": "http://${PREFIX}-gitea-integration:8088",
    "FORGE_EGRESS_PROXY": "http://${PREFIX}-egress-proxy:3128"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/executions",
      "action": "createExecution",
      "resource": "forge/executions"
    },
    {
      "method": "GET",
      "path": "/executions",
      "action": "listExecution",
      "resource": "forge/executions"
    },
    {
      "method": "GET",
      "path": "/executions/{id}",
      "action": "getExecution",
      "resource": "forge/executions/{id}"
    },
    {
      "method": "DELETE",
      "path": "/executions/{id}",
      "action": "deleteExecution",
      "resource": "forge/executions/{id}"
    },
    {
      "method": "GET",
      "path": "/images",
      "action": "listImage",
      "resource": "forge/images"
    },
    {
      "method": "GET",
      "path": "/runner-classes",
      "action": "listRunnerClass",
      "resource": "forge/runner-classes"
    },
    {
      "method": "POST",
      "path": "/runner-classes",
      "action": "createRunnerClass",
      "resource": "forge/runner-classes"
    },
    {
      "method": "GET",
      "path": "/runner-classes/{name}",
      "action": "getRunnerClass",
      "resource": "forge/runner-classes/{name}"
    },
    {
      "method": "PUT",
      "path": "/runner-classes/{name}",
      "action": "updateRunnerClass",
      "resource": "forge/runner-classes/{name}"
    },
    {
      "method": "DELETE",
      "path": "/runner-classes/{name}",
      "action": "deleteRunnerClass",
      "resource": "forge/runner-classes/{name}"
    },
    {
      "method": "GET",
      "path": "/runtime-backends",
      "action": "listRuntimeBackend",
      "resource": "forge/runtime-backends"
    },
    {
      "method": "POST",
      "path": "/runtime-backends",
      "action": "createRuntimeBackend",
      "resource": "forge/runtime-backends"
    },
    {
      "method": "GET",
      "path": "/runtime-backends/{name}",
      "action": "getRuntimeBackend",
      "resource": "forge/runtime-backends/{name}"
    },
    {
      "method": "PUT",
      "path": "/runtime-backends/{name}",
      "action": "updateRuntimeBackend",
      "resource": "forge/runtime-backends/{name}"
    },
    {
      "method": "DELETE",
      "path": "/runtime-backends/{name}",
      "action": "deleteRuntimeBackend",
      "resource": "forge/runtime-backends/{name}"
    }
  ],
  "actions": [
    {
      "name": "forge/run",
      "method": "POST",
      "path": "/executions",
      "body_transforms": [
        {
          "from_key": "run",
          "to_key": "command",
          "wrap": [
            "sh",
            "-c"
          ]
        }
      ],
      "async": {
        "id_field": "execution_id",
        "poll_path": "/executions/{id}",
        "poll_interval_secs": 2,
        "status_field": "status",
        "success_states": [
          "completed"
        ],
        "failure_states": [
          "failed",
          "timed_out"
        ],
        "cancel_states": [
          "cancelled"
        ],
        "output_map_field": "outputs",
        "output_field": "stdout",
        "error_fields": [
          "stderr"
        ]
      }
    }
  ],
  "default_grants": [
    {
      "grant_on": "user",
      "actions": [
        "createExecution",
        "listExecution",
        "getExecution",
        "deleteExecution"
      ],
      "resources": [
        "{username}/forge/executions",
        "{username}/forge/executions/*"
      ]
    },
    {
      "grant_on": "user",
      "actions": [
        "listRunnerClass",
        "getRunnerClass"
      ],
      "resources": [
        "{username}/forge/runner-classes",
        "{username}/forge/runner-classes/*"
      ]
    },
    {
      "grant_on": "user",
      "actions": [
        "listRuntimeBackend",
        "getRuntimeBackend"
      ],
      "resources": [
        "{username}/forge/runtime-backends",
        "{username}/forge/runtime-backends/*"
      ]
    },
    {
      "grant_on": "user",
      "actions": [
        "listImage"
      ],
      "resources": [
        "{username}/forge/images"
      ]
    }
  ]
}
