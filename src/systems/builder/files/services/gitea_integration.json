{
  "registryName": "gitea_integration",
  "k8sName": "gitea-integration",
  "imageRepo": "gitea_integration",
  "port": 8088,
  "forward_auth": true,
  "description": "Forgejo/Gitea git repository management",
  "registryAccount": false,
  "infra": {},
  "derivedSecrets": [
    {
      "envVar": "GITEA_INTERNAL_KEY",
      "kind": "shared",
      "name": "gitea-internal-key"
    }
  ],
  "requiredConfig": [
    "DATABASE_URL",
    "GITEA_URL",
    "GITEA_ADMIN_TOKEN"
  ],
  "optionalConfig": [],
  "secretConfig": [
    "DATABASE_URL",
    "GITEA_ADMIN_TOKEN"
  ],
  "envExtras": {},
  "endpoints": [
    {
      "method": "GET",
      "path": "/account",
      "action": "getAccount",
      "resource": "gitea_integration/account"
    },
    {
      "method": "PUT",
      "path": "/account",
      "action": "linkAccount",
      "resource": "gitea_integration/account"
    },
    {
      "method": "DELETE",
      "path": "/account",
      "action": "unlinkAccount",
      "resource": "gitea_integration/account"
    },
    {
      "method": "GET",
      "path": "/repos",
      "action": "listRepo",
      "resource": "gitea_integration/repos"
    },
    {
      "method": "POST",
      "path": "/repos",
      "action": "createRepo",
      "resource": "gitea_integration/repos"
    },
    {
      "method": "GET",
      "path": "/repos/{owner}/{name}",
      "action": "getRepo",
      "resource": "gitea_integration/repos/{owner}/{name}"
    },
    {
      "method": "DELETE",
      "path": "/repos/{owner}/{name}",
      "action": "deleteRepo",
      "resource": "gitea_integration/repos/{owner}/{name}"
    },
    {
      "method": "PUT",
      "path": "/repos/{owner}/{name}/project",
      "action": "setRepoProject",
      "resource": "gitea_integration/repos/{owner}/{name}"
    },
    {
      "method": "GET",
      "path": "/repos/{owner}/{name}/branches",
      "action": "listBranch",
      "resource": "gitea_integration/repos/{owner}/{name}"
    },
    {
      "method": "GET",
      "path": "/repos/{owner}/{name}/tags",
      "action": "listTag",
      "resource": "gitea_integration/repos/{owner}/{name}"
    },
    {
      "method": "GET",
      "path": "/repos/{owner}/{name}/releases",
      "action": "listRelease",
      "resource": "gitea_integration/repos/{owner}/{name}"
    },
    {
      "method": "GET",
      "path": "/repos/{owner}/{name}/commits",
      "action": "listCommit",
      "resource": "gitea_integration/repos/{owner}/{name}"
    },
    {
      "method": "GET",
      "path": "/repos/{owner}/{name}/pulls",
      "action": "listPull",
      "resource": "gitea_integration/repos/{owner}/{name}/pulls"
    },
    {
      "method": "POST",
      "path": "/repos/{owner}/{name}/pulls",
      "action": "createPull",
      "resource": "gitea_integration/repos/{owner}/{name}/pulls"
    },
    {
      "method": "GET",
      "path": "/repos/{owner}/{name}/pulls/{index}",
      "action": "getPull",
      "resource": "gitea_integration/repos/{owner}/{name}/pulls/{index}"
    },
    {
      "method": "POST",
      "path": "/repos/{owner}/{name}/pulls/{index}/merge",
      "action": "mergePull",
      "resource": "gitea_integration/repos/{owner}/{name}/pulls/{index}"
    }
  ],
  "actions": [],
  "default_grants": [
    {
      "grant_on": "user",
      "actions": [
        "getAccount",
        "linkAccount",
        "unlinkAccount",
        "listRepo",
        "createRepo"
      ],
      "resources": [
        "{username}/gitea_integration/account",
        "{username}/gitea_integration/repos"
      ]
    },
    {
      "grant_on": "user",
      "actions": [
        "getRepo",
        "deleteRepo",
        "setRepoProject",
        "listBranch",
        "listTag",
        "listRelease",
        "listCommit",
        "listPull",
        "createPull",
        "getPull",
        "mergePull"
      ],
      "resources": [
        "{username}/gitea_integration/repos/*"
      ]
    },
    {
      "grant_on": "user",
      "actions": [
        "getRegistryToken"
      ],
      "resources": [
        "{username}/gitea_integration/registry-token"
      ]
    }
  ]
}
