{
  "registryName": "codearmory_git_factory",
  "k8sName": "git-factory",
  "imageRepo": "git-factory",
  "port": 9002,
  "forward_auth": true,
  "description": "The git plane of the codearmory platform (repos + Smart-HTTP)",
  "ui_path": "",
  "registryAccount": false,
  "infra": {
    "managedRedis": false,
    "persistence": {
      "mountPath": "/var/lib/git-factory",
      "size": "20Gi",
      "storageClass": "",
      "accessMode": "ReadWriteOnce"
    }
  },
  "derivedSecrets": [],
  "requiredConfig": [
    "DATABASE_URL"
  ],
  "optionalConfig": [
    "GIT_HTTP_BASE_URL",
    "DATABASE_READ_URL",
    "LOG_LEVEL"
  ],
  "secretConfig": [
    "DATABASE_URL",
    "DATABASE_READ_URL"
  ],
  "envExtras": {
    "GIT_STORAGE_ROOT": "/var/lib/git-factory"
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/Repos",
      "action": "listRepo",
      "resource": "codearmory_git_factory/Repos"
    },
    {
      "method": "POST",
      "path": "/Repos",
      "action": "createRepo",
      "resource": "codearmory_git_factory/Repos"
    },
    {
      "method": "GET",
      "path": "/Repos/{id}",
      "action": "getRepo",
      "resource": "codearmory_git_factory/Repos/{id}"
    },
    {
      "method": "PUT",
      "path": "/Repos/{id}",
      "action": "updateRepo",
      "resource": "codearmory_git_factory/Repos/{id}"
    },
    {
      "method": "DELETE",
      "path": "/Repos/{id}",
      "action": "deleteRepo",
      "resource": "codearmory_git_factory/Repos/{id}"
    }
  ],
  "actions": [],
  "default_grants": [
    {
      "grant_on": "user",
      "actions": [
        "createRepo",
        "listRepo"
      ],
      "resources": [
        "{username}/codearmory_git_factory/Repos"
      ]
    },
    {
      "grant_on": "user",
      "actions": [
        "getRepo",
        "updateRepo",
        "deleteRepo",
        "readRepo",
        "writeRepo"
      ],
      "resources": [
        "{username}/codearmory_git_factory/Repos/*"
      ]
    }
  ]
}
