{
  "registryName": "blueprints",
  "k8sName": "blueprints",
  "imageRepo": "blueprints",
  "port": 8093,
  "forward_auth": true,
  "description": "OpenTofu/Terraform remote state storage",
  "registryAccount": false,
  "infra": {
    "managedRedis": true
  },
  "derivedSecrets": [
    {
      "envVar": "ENCRYPTION_KEY",
      "kind": "private",
      "name": "encryption-key"
    }
  ],
  "requiredConfig": [
    "DATABASE_URL"
  ],
  "optionalConfig": [],
  "secretConfig": [
    "DATABASE_URL",
    "REDIS_URL"
  ],
  "envExtras": {},
  "endpoints": [
    {
      "method": "GET",
      "path": "/state/{username}/{workspace}",
      "action": "getState",
      "resource": "states/{username}/{workspace}"
    },
    {
      "method": "POST",
      "path": "/state/{username}/{workspace}",
      "action": "updateState",
      "resource": "states/{username}/{workspace}"
    },
    {
      "method": "DELETE",
      "path": "/state/{username}/{workspace}",
      "action": "deleteState",
      "resource": "states/{username}/{workspace}"
    },
    {
      "method": "LOCK",
      "path": "/state/{username}/{workspace}",
      "action": "lockState",
      "resource": "states/{username}/{workspace}"
    },
    {
      "method": "UNLOCK",
      "path": "/state/{username}/{workspace}",
      "action": "unlockState",
      "resource": "states/{username}/{workspace}"
    },
    {
      "method": "POST",
      "path": "/backend",
      "action": "createBackend",
      "resource": "states"
    }
  ],
  "actions": [
    {
      "name": "blueprints/backend",
      "method": "POST",
      "path": "/backend"
    }
  ],
  "default_grants": [
    {
      "grant_on": "user",
      "actions": [
        "getState",
        "updateState",
        "deleteState",
        "lockState",
        "unlockState",
        "createBackend"
      ],
      "resources": [
        "{username}/states/{username}/*",
        "{username}/states"
      ]
    }
  ]
}
