{
  "registryName": "tickets",
  "k8sName": "tickets",
  "imageRepo": "tickets",
  "port": 8086,
  "forward_auth": true,
  "description": "Issue and task tracking",
  "registryAccount": false,
  "infra": {},
  "derivedSecrets": [
    {
      "envVar": "HOOKS_TRIGGER_KEY",
      "kind": "shared",
      "name": "hooks-trigger-key"
    }
  ],
  "requiredConfig": [
    "DATABASE_URL"
  ],
  "optionalConfig": [],
  "secretConfig": [
    "DATABASE_URL"
  ],
  "envExtras": {
    "HOOKS_URL": "http://${PREFIX}-hooks:8087"
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/tickets",
      "action": "createTicket",
      "resource": "tickets/tickets"
    },
    {
      "method": "GET",
      "path": "/tickets",
      "action": "listTicket",
      "resource": "tickets/tickets"
    },
    {
      "method": "GET",
      "path": "/tickets/{id}",
      "action": "getTicket",
      "resource": "tickets/tickets/{id}"
    },
    {
      "method": "PUT",
      "path": "/tickets/{id}",
      "action": "updateTicket",
      "resource": "tickets/tickets/{id}"
    },
    {
      "method": "DELETE",
      "path": "/tickets/{id}",
      "action": "deleteTicket",
      "resource": "tickets/tickets/{id}"
    },
    {
      "method": "POST",
      "path": "/tickets/{id}/comments",
      "action": "createComment",
      "resource": "tickets/tickets/{id}"
    },
    {
      "method": "DELETE",
      "path": "/tickets/{id}/comments/{comment_id}",
      "action": "deleteComment",
      "resource": "tickets/tickets/{id}/comments/{comment_id}"
    },
    {
      "method": "GET",
      "path": "/field-defs",
      "action": "listFieldDef",
      "resource": "tickets/field-defs"
    },
    {
      "method": "POST",
      "path": "/field-defs",
      "action": "createFieldDef",
      "resource": "tickets/field-defs"
    },
    {
      "method": "PUT",
      "path": "/field-defs/{id}",
      "action": "updateFieldDef",
      "resource": "tickets/field-defs/{id}"
    },
    {
      "method": "DELETE",
      "path": "/field-defs/{id}",
      "action": "deleteFieldDef",
      "resource": "tickets/field-defs/{id}"
    }
  ],
  "actions": [
    {
      "name": "tickets/create",
      "method": "POST",
      "path": "/tickets"
    },
    {
      "name": "tickets/update",
      "method": "PUT",
      "path": "/tickets/{id}"
    },
    {
      "name": "tickets/delete",
      "method": "DELETE",
      "path": "/tickets/{id}"
    }
  ],
  "default_grants": [
    {
      "grant_on": "user",
      "actions": [
        "createTicket",
        "listTicket",
        "getTicket",
        "updateTicket",
        "deleteTicket",
        "createComment",
        "deleteComment",
        "listFieldDef",
        "createFieldDef",
        "updateFieldDef",
        "deleteFieldDef"
      ],
      "resources": [
        "{username}/tickets/tickets",
        "{username}/tickets/tickets/*",
        "{username}/tickets/field-defs",
        "{username}/tickets/field-defs/*"
      ]
    }
  ]
}
