# CI fast-path image — built by forge/build-image (kaniko) in the codearmory-ci pipeline.
#
# Unlike ./Dockerfile (self-contained multi-stage, used by local `docker build`), this image
# does NOT compile Go. The `git-factory` binary is prebuilt by the pipeline's build step on the
# shared, warm Go build-cache volume and already sits in the build context; here we only
# package it. kaniko cannot share Go's build cache across a source change, so compiling
# in-image otherwise recompiles the full dependency tree every commit; and a byte-identical
# prebuilt binary makes the whole image a kaniko layer-cache hit.
FROM public.ecr.aws/docker/library/alpine:3.23.3
# git is a RUNTIME dependency, not just a build one: the git plane shells out to
# git/git-upload-pack/git-receive-pack (docs/git-factory/ARCHITECTURE.md §1, §5 step 1).
# This is why this image differs from every other service's — do not drop the git package.
RUN apk --no-cache add ca-certificates git && addgroup -S -g 101 svc && adduser -S -u 100 -G svc svc
WORKDIR /home/svc/
COPY git-factory ./git-factory
RUN chown svc:svc ./git-factory
USER 100:101
EXPOSE 9002
CMD ["./git-factory"]
