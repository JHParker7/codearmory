{
  "name": "forge",
  "description": "Sandboxed code execution service",
  "roles": [
    {
      "name": "executor",
      "description": "Can submit and manage code executions"
    },
    {
      "name": "viewer",
      "description": "Read-only access to execution history"
    }
  ],
  "endpoints": [
    { "method": "POST",   "path": "/executions",      "action": "createExecution", "resource": "executions", "description": "Submit a new code execution" },
    { "method": "GET",    "path": "/executions",      "action": "listExecution",   "resource": "executions", "description": "List executions" },
    { "method": "GET",    "path": "/executions/{id}", "action": "getExecution",    "resource": "executions", "description": "Get an execution by ID" },
    { "method": "DELETE", "path": "/executions/{id}", "action": "deleteExecution", "resource": "executions", "description": "Cancel or delete an execution" }
  ]
}
