[
  {
    "name": "gatekeeper",
    "url": "http://gatekeeper:8080",
    "description": "Authentication, authorisation and user management",
    "forward_auth": true,
    "service_key": "gatekeeper-registry-local-secret",
    "endpoints": [
      { "method": "POST",   "path": "/signup",                               "action": "signup",            "resource": "gatekeeper/users",            "public": true  },
      { "method": "POST",   "path": "/login",                                "action": "login",             "resource": "gatekeeper/users",            "public": true  },
      { "method": "GET",    "path": "/users",                                "action": "listUser",          "resource": "gatekeeper/users"             },
      { "method": "GET",    "path": "/users/{id}",                           "action": "getUser",           "resource": "gatekeeper/users/{id}"        },
      { "method": "PUT",    "path": "/users/{id}",                           "action": "updateUser",        "resource": "gatekeeper/users/{id}"        },
      { "method": "DELETE", "path": "/users/{id}",                           "action": "deleteUser",        "resource": "gatekeeper/users/{id}"        },
      { "method": "GET",    "path": "/orgs",                                 "action": "listOrg",           "resource": "gatekeeper/orgs"              },
      { "method": "POST",   "path": "/orgs",                                 "action": "createOrg",         "resource": "gatekeeper/orgs"              },
      { "method": "GET",    "path": "/orgs/{id}",                            "action": "getOrg",            "resource": "gatekeeper/orgs/{id}"         },
      { "method": "PUT",    "path": "/orgs/{id}",                            "action": "updateOrg",         "resource": "gatekeeper/orgs/{id}"         },
      { "method": "DELETE", "path": "/orgs/{id}",                            "action": "deleteOrg",         "resource": "gatekeeper/orgs/{id}"         },
      { "method": "GET",    "path": "/teams",                                "action": "listTeam",          "resource": "gatekeeper/teams"             },
      { "method": "POST",   "path": "/teams",                                "action": "createTeam",        "resource": "gatekeeper/teams"             },
      { "method": "GET",    "path": "/teams/{id}",                           "action": "getTeam",           "resource": "gatekeeper/teams/{id}"        },
      { "method": "PUT",    "path": "/teams/{id}",                           "action": "updateTeam",        "resource": "gatekeeper/teams/{id}"        },
      { "method": "DELETE", "path": "/teams/{id}",                           "action": "deleteTeam",        "resource": "gatekeeper/teams/{id}"        },
      { "method": "POST",   "path": "/roles",                                "action": "createRole",        "resource": "gatekeeper/roles"             },
      { "method": "GET",    "path": "/roles/{id}",                           "action": "getRole",           "resource": "gatekeeper/roles/{id}"        },
      { "method": "PUT",    "path": "/roles/{id}",                           "action": "updateRole",        "resource": "gatekeeper/roles/{id}"        },
      { "method": "DELETE", "path": "/roles/{id}",                           "action": "deleteRole",        "resource": "gatekeeper/roles/{id}"        },
      { "method": "POST",   "path": "/permissions",                          "action": "createPermission",  "resource": "gatekeeper/permissions"       },
      { "method": "GET",    "path": "/permissions/{id}",                     "action": "getPermission",     "resource": "gatekeeper/permissions/{id}"  },
      { "method": "PUT",    "path": "/permissions/{id}",                     "action": "updatePermission",  "resource": "gatekeeper/permissions/{id}"  },
      { "method": "DELETE", "path": "/permissions/{id}",                     "action": "deletePermission",  "resource": "gatekeeper/permissions/{id}"  },
      { "method": "GET",    "path": "/sessions/{id}",                        "action": "getSession",        "resource": "gatekeeper/sessions/{id}"     },
      { "method": "DELETE", "path": "/sessions/{id}",                        "action": "deleteSession",     "resource": "gatekeeper/sessions/{id}"     },
      { "method": "GET",    "path": "/invites",                              "action": "listInvite",        "resource": "gatekeeper/invites"           },
      { "method": "GET",    "path": "/invites/{id}",                         "action": "getInvite",         "resource": "gatekeeper/invites/{id}"      },
      { "method": "DELETE", "path": "/invites/{id}",                         "action": "deleteInvite",      "resource": "gatekeeper/invites/{id}"      },
      { "method": "POST",   "path": "/orgs/{id}/invites",                    "action": "inviteUser",        "resource": "gatekeeper/orgs/{id}"         },
      { "method": "POST",   "path": "/teams/{id}/invites",                   "action": "inviteUser",        "resource": "gatekeeper/teams/{id}"        },
      { "method": "POST",   "path": "/invites/{id}/accept",                  "action": "acceptInvite",      "resource": "gatekeeper/invites/{id}"      },
      { "method": "POST",   "path": "/invites/{id}/decline",                 "action": "declineInvite",     "resource": "gatekeeper/invites/{id}"      },
      { "method": "GET",    "path": "/audit-logs",                           "action": "listAuditLog",      "resource": "gatekeeper/audit-logs"        },
      { "method": "GET",    "path": "/service-permission-requests",          "action": "listSPR",           "resource": "gatekeeper/service-permission-requests" },
      { "method": "GET",    "path": "/service-permission-requests/{id}",     "action": "getSPR",            "resource": "gatekeeper/service-permission-requests/{id}" },
      { "method": "POST",   "path": "/service-permission-requests/{id}/approve", "action": "approveSPR",   "resource": "gatekeeper/service-permission-requests/{id}" },
      { "method": "POST",   "path": "/service-permission-requests/{id}/decline", "action": "declineSPR",   "resource": "gatekeeper/service-permission-requests/{id}" }
    ]
  },
  {
    "name": "blueprints",
    "url": "http://blueprints:8081",
    "description": "OpenTofu/Terraform remote state storage",
    "forward_auth": true,
    "service_key": "blueprints-registry-local-secret",
    "endpoints": [
      { "method": "GET",    "path": "/state/{username}/{workspace}", "action": "getState",    "resource": "states/{username}/{workspace}" },
      { "method": "POST",   "path": "/state/{username}/{workspace}", "action": "updateState", "resource": "states/{username}/{workspace}" },
      { "method": "DELETE", "path": "/state/{username}/{workspace}", "action": "deleteState", "resource": "states/{username}/{workspace}" },
      { "method": "LOCK",   "path": "/state/{username}/{workspace}", "action": "lockState",   "resource": "states/{username}/{workspace}" },
      { "method": "UNLOCK", "path": "/state/{username}/{workspace}", "action": "unlockState", "resource": "states/{username}/{workspace}" }
    ]
  },
  {
    "name": "forge",
    "url": "http://forge:8083",
    "description": "Sandboxed code execution",
    "forward_auth": true,
    "service_key": "forge-registry-local-secret",
    "endpoints": [
      { "method": "POST",   "path": "/executions",      "action": "createExecution", "resource": "forge/executions" },
      { "method": "GET",    "path": "/executions",      "action": "listExecution",   "resource": "forge/executions" },
      { "method": "GET",    "path": "/executions/{id}", "action": "getExecution",    "resource": "forge/executions/{id}" },
      { "method": "DELETE", "path": "/executions/{id}", "action": "deleteExecution", "resource": "forge/executions/{id}" }
    ]
  }
]
