  {
    "name": "forge",
    "url": "http://forge:8083",
    "description": "Sandboxed code execution",
    "forward_auth": true,
    "service_key": "forge-registry-local-secret",
    "endpoints": [
      { "method": "POST",   "path": "/executions",               "action": "createExecution",   "resource": "forge/executions" },
      { "method": "GET",    "path": "/executions",               "action": "listExecution",     "resource": "forge/executions" },
      { "method": "GET",    "path": "/executions/{id}",          "action": "getExecution",      "resource": "forge/executions/{id}" },
      { "method": "DELETE", "path": "/executions/{id}",          "action": "deleteExecution",   "resource": "forge/executions/{id}" },
      { "method": "GET",    "path": "/images",                   "action": "listImage",         "resource": "forge/images" },
      { "method": "GET",    "path": "/runner-classes",           "action": "listRunnerClass",   "resource": "forge/runner-classes" },
      { "method": "POST",   "path": "/runner-classes",           "action": "createRunnerClass", "resource": "forge/runner-classes" },
      { "method": "GET",    "path": "/runner-classes/{name}",    "action": "getRunnerClass",    "resource": "forge/runner-classes/{name}" },
      { "method": "PUT",    "path": "/runner-classes/{name}",    "action": "updateRunnerClass", "resource": "forge/runner-classes/{name}" },
      { "method": "DELETE", "path": "/runner-classes/{name}",    "action": "deleteRunnerClass", "resource": "forge/runner-classes/{name}" },
      { "method": "GET",    "path": "/runtime-backends",         "action": "listRuntimeBackend",   "resource": "forge/runtime-backends" },
      { "method": "POST",   "path": "/runtime-backends",         "action": "createRuntimeBackend", "resource": "forge/runtime-backends" },
      { "method": "GET",    "path": "/runtime-backends/{name}",  "action": "getRuntimeBackend",    "resource": "forge/runtime-backends/{name}" },
      { "method": "PUT",    "path": "/runtime-backends/{name}",  "action": "updateRuntimeBackend", "resource": "forge/runtime-backends/{name}" },
      { "method": "DELETE", "path": "/runtime-backends/{name}",  "action": "deleteRuntimeBackend", "resource": "forge/runtime-backends/{name}" },
      { "method": "POST",   "path": "/volumes",                  "action": "createVolume",         "resource": "forge/volumes" },
      { "method": "GET",    "path": "/volumes",                  "action": "listVolume",           "resource": "forge/volumes" },
      { "method": "DELETE", "path": "/volumes",                  "action": "deleteVolume",         "resource": "forge/volumes" }
    ],
    "actions": [
      {
        "name": "forge/create-volume",
        "summary": "Create a shared workspace volume for a workflow run",
        "description": "Provisions a run-scoped shared volume (a RAM/tmpfs-backed PVC in Kubernetes, a tmpfs named volume in Docker) that later steps can attach via the `volumes` key on a `forge/run` step. A git step clones a repo into it; downstream steps mount the same volume and see the checkout plus any build artifacts — and never need `git` in their own image. Pass `workflow_id` (use `${run_id}`), an optional `name` (default `workspace`), `size_mb`, and `medium` (`memory` default, or `disk`). The summed size of all of a workflow's volumes is capped by the admin (FORGE_MAX_WORKFLOW_VOLUME_MB). Volumes are torn down automatically when the run ends.",
        "method": "POST",
        "path": "/volumes",
        "required_permission": { "action": "createVolume", "resource": "forge/volumes" },
        "async": {
          "id_field": "resource_name",
          "poll_path": "/volumes/{id}",
          "poll_interval_secs": 2,
          "status_field": "status",
          "success_states": ["ready"],
          "failure_states": ["failed"],
          "error_fields": ["detail"]
        }
      },
      {
        "name": "forge/run",
        "summary": "Run a shell command in a sandboxed container",
        "description": "Executes the step's `run` script inside an isolated Forge container (dropped capabilities, optional egress allowlist) and polls the execution to completion. The step output is the values captured via `output_env` (none by default — stdout is not a step output); a failed run still surfaces its stdout for debugging. Use it for build, test, and deploy steps. The `run` input is wrapped as `sh -c <run>`; pass an image and resource limits via the step's other `with` keys.",
        "method": "POST",
        "path": "/executions",
        "body_transforms": [
          { "from_key": "run", "to_key": "command", "wrap": ["sh", "-c"] }
        ],
        "async": {
          "id_field": "execution_id",
          "poll_path": "/executions/{id}",
          "poll_interval_secs": 2,
          "status_field": "status",
          "success_states": ["completed"],
          "failure_states": ["failed", "timed_out"],
          "cancel_states": ["cancelled"],
          "output_field": "stdout",
          "output_map_field": "outputs",
          "error_fields": ["stderr"]
        }
      },
      {
        "name": "forge/build-image",
        "summary": "Build and push a container image",
        "description": "Builds a container image from a Dockerfile and pushes it to a registry, with no Docker daemon and no host socket — the actions/docker-build-push equivalent. Forge builds with Kaniko (daemonless, userspace layer extraction), which runs on both kernel-isolated backends. Builds REQUIRE a privileged runner class on a kata or gvisor backend (root + writable rootfs, safe behind the VM/Sentry boundary); they are rejected on the shared-kernel docker/kubernetes backends. Pass `build` = { context (default /workspace — usually an attached shared volume), dockerfile, destinations, build_args, target, no_push }, attach the source via `volumes`, and provide registry credentials as a Docker config.json under a `secret_refs` env named REGISTRY_AUTH. Set `runner_class` to a privileged build class.",
        "method": "POST",
        "path": "/executions",
        "required_permission": { "action": "createExecution", "resource": "forge/executions" },
        "async": {
          "id_field": "execution_id",
          "poll_path": "/executions/{id}",
          "poll_interval_secs": 5,
          "status_field": "status",
          "success_states": ["completed"],
          "failure_states": ["failed", "timed_out"],
          "cancel_states": ["cancelled"],
          "output_field": "stdout",
          "output_map_field": "outputs",
          "error_fields": ["stderr"]
        }
      },
      {
        "name": "forge/git-clone",
        "summary": "Clone a git repo into a shared volume",
        "description": "Clones a git repository into a run-scoped shared workspace volume so later steps build from the checkout without needing `git` in their own image (the actions/checkout equivalent). Create the volume first with `forge/create-volume`, then attach the same volume name here; the repo — wired per step via the git credential broker and injected as `$GIT_CLONE_URL` — is shallow-cloned into it on forge's built-in minimal git image (there is no image to pick or maintain; operators can override it via FORGE_GIT_IMAGE). Downstream `forge/run` steps attach the same volume to see the working tree. Optional `path` (clone dir), `ref` (branch/tag), and `depth` (0 = full clone) tune it.",
        "method": "POST",
        "path": "/executions",
        "body_transforms": [
          { "from_key": "run", "to_key": "command", "wrap": ["sh", "-c"] }
        ],
        "required_permission": { "action": "createExecution", "resource": "forge/executions" },
        "async": {
          "id_field": "execution_id",
          "poll_path": "/executions/{id}",
          "poll_interval_secs": 2,
          "status_field": "status",
          "success_states": ["completed"],
          "failure_states": ["failed", "timed_out"],
          "cancel_states": ["cancelled"],
          "output_field": "stdout",
          "output_map_field": "outputs",
          "error_fields": ["stderr"]
        }
      }
    ],
    "default_grants": [
      {
        "grant_on": "user",
        "actions": ["createExecution", "listExecution", "getExecution", "deleteExecution"],
        "resources": ["{username}/forge/executions", "{username}/forge/executions/*"]
      },
      {
        "grant_on": "user",
        "actions": ["createVolume", "listVolume", "getVolume", "deleteVolume"],
        "resources": ["{username}/forge/volumes", "{username}/forge/volumes/*"]
      },
      {
        "grant_on": "user",
        "actions": ["listRunnerClass", "getRunnerClass"],
        "resources": ["{username}/forge/runner-classes", "{username}/forge/runner-classes/*"]
      },
      {
        "grant_on": "user",
        "actions": ["listRuntimeBackend", "getRuntimeBackend"],
        "resources": ["{username}/forge/runtime-backends", "{username}/forge/runtime-backends/*"]
      },
      {
        "grant_on": "user",
        "actions": ["listImage"],
        "resources": ["{username}/forge/images"]
      }
    ]
  },
  {
    "name": "workflows",
    "url": "http://workflows:8085",
    "description": "CI/CD pipeline orchestration",
    "forward_auth": true,
    "service_key": "workflows-registry-local-secret",
    "endpoints": [
      { "method": "POST",   "path": "/steps",      "action": "createStep", "resource": "workflows/steps" },
      { "method": "GET",    "path": "/steps",      "action": "listStep",   "resource": "workflows/steps" },
      { "method": "GET",    "path": "/steps/{id}", "action": "getStep",    "resource": "workflows/steps/{id}" },
      { "method": "PUT",    "path": "/steps/{id}", "action": "updateStep", "resource": "workflows/steps/{id}" },
      { "method": "DELETE", "path": "/steps/{id}", "action": "deleteStep", "resource": "workflows/steps/{id}" },
      { "method": "POST",   "path": "/pipelines",           "action": "createWorkflow", "resource": "workflows/pipelines" },
      { "method": "GET",    "path": "/pipelines",           "action": "listWorkflow",   "resource": "workflows/pipelines" },
      { "method": "GET",    "path": "/pipelines/{id}",      "action": "getWorkflow",    "resource": "workflows/pipelines/{id}" },
      { "method": "PUT",    "path": "/pipelines/{id}",      "action": "updateWorkflow", "resource": "workflows/pipelines/{id}" },
      { "method": "DELETE", "path": "/pipelines/{id}",      "action": "deleteWorkflow", "resource": "workflows/pipelines/{id}" },
      { "method": "POST",   "path": "/pipelines/{id}/runs", "action": "triggerRun",     "resource": "workflows/runs/{id}" },
      { "method": "GET",    "path": "/runs",                "action": "listRun",        "resource": "workflows/runs" },
      { "method": "GET",    "path": "/runs/{id}",           "action": "getRun",         "resource": "workflows/runs/{id}" },
      { "method": "DELETE", "path": "/runs/{id}",           "action": "cancelRun",      "resource": "workflows/runs/{id}" },
      { "method": "POST",   "path": "/runs/{id}/approve",   "action": "approveRun",     "resource": "workflows/runs/{id}" },
      { "method": "POST",   "path": "/runs/{id}/reject",    "action": "approveRun",     "resource": "workflows/runs/{id}" },
      { "method": "GET",    "path": "/pipelines/{id}/runs/{run_id}", "action": "getRun",    "resource": "workflows/runs/{id}/{run_id}" },
      { "method": "DELETE", "path": "/pipelines/{id}/runs/{run_id}", "action": "cancelRun", "resource": "workflows/runs/{id}/{run_id}" },
      { "method": "POST",   "path": "/pipelines/{id}/runs/{run_id}/approve", "action": "approveRun", "resource": "workflows/runs/{id}/{run_id}" },
      { "method": "POST",   "path": "/pipelines/{id}/runs/{run_id}/reject",  "action": "approveRun", "resource": "workflows/runs/{id}/{run_id}" },
      { "method": "GET",    "path": "/actions",             "action": "listAction",     "resource": "workflows/actions" }
    ],
    "default_grants": [
      {
        "grant_on": "user",
        "actions": ["createStep", "listStep", "getStep", "updateStep", "deleteStep", "createWorkflow", "listWorkflow", "getWorkflow", "updateWorkflow", "deleteWorkflow", "triggerRun", "listRun", "getRun", "cancelRun", "approveRun"],
        "resources": ["{username}/workflows/steps", "{username}/workflows/steps/*", "{username}/workflows/pipelines", "{username}/workflows/pipelines/*", "{username}/workflows/runs", "{username}/workflows/runs/*"]
      },
      {
        "grant_on": "user",
        "actions": ["listAction"],
        "resources": ["{username}/workflows/actions"]
      }
    ]
  },
  {
