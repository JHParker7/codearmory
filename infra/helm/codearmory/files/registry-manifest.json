      {
        "method": "GET",
        "path": "/secrets",
        "action": "listSecrets",
        "resource": "gatekeeper/secrets"
      },
      {
        "method": "PUT",
        "path": "/secrets/{id}",
        "action": "updateSecret",
        "resource": "gatekeeper/secrets/{id}"
      },
      {
        "method": "DELETE",
        "path": "/secrets/{id}",
        "action": "deleteSecret",
        "resource": "gatekeeper/secrets/{id}"
      },
      {
        "method": "GET",
        "path": "/orgs/{id}/secret-provider",
        "action": "getSecretProvider",
        "resource": "gatekeeper/orgs/{id}"
      },
      {
        "method": "PUT",
        "path": "/orgs/{id}/secret-provider",
        "action": "updateSecretProvider",
        "resource": "gatekeeper/orgs/{id}"
      },
      {
        "method": "DELETE",
        "path": "/orgs/{id}/secret-provider",
        "action": "deleteSecretProvider",
        "resource": "gatekeeper/orgs/{id}"
      },
      {
        "method": "GET",
        "path": "/audit-logs",
        "action": "listAuditLog",
        "resource": "gatekeeper/audit-logs"
      },
      {
        "method": "GET",
        "path": "/service-permission-requests",
        "action": "listSPR",
        "resource": "gatekeeper/service-permission-requests"
      },
      {
        "method": "GET",
        "path": "/service-permission-requests/{id}",
        "action": "getSPR",
        "resource": "gatekeeper/service-permission-requests/{id}"
      },
      {
        "method": "POST",
        "path": "/service-permission-requests/{id}/approve",
        "action": "approveSPR",
        "resource": "gatekeeper/service-permission-requests/{id}"
      },
      {
        "method": "POST",
        "path": "/service-permission-requests/{id}/decline",
        "action": "declineSPR",
        "resource": "gatekeeper/service-permission-requests/{id}"
      },
      {
        "method": "POST",
        "path": "/mfa/verify",
        "action": "mfaVerify",
        "resource": "gatekeeper/mfa",
        "public": true
      },
      {
        "method": "GET",
        "path": "/oauth/mfa",
        "action": "oauthMFA",
        "resource": "gatekeeper/mfa",
        "public": true
      },
      {
        "method": "POST",
        "path": "/oauth/mfa",
        "action": "oauthMFA",
        "resource": "gatekeeper/mfa",
        "public": true
      },
      {
        "method": "POST",
        "path": "/mfa/totp/enroll",
        "action": "enrollTOTP",
        "resource": "gatekeeper/mfa"
      },
      {
        "method": "POST",
        "path": "/mfa/totp/confirm",
        "action": "confirmTOTP",
        "resource": "gatekeeper/mfa"
      },
      {
        "method": "GET",
        "path": "/mfa/totp/status",
        "action": "getMFAStatus",
        "resource": "gatekeeper/mfa"
      },
      {
        "method": "DELETE",
        "path": "/mfa/totp",
        "action": "disableTOTP",
        "resource": "gatekeeper/mfa"
      }
    ],
    "default_grants": [
      {
        "grant_on": "user",
        "actions": [
          "getUser",
          "updateUser",
          "deleteUser",
          "createOrg",
          "createTeam"
        ],
        "resources": [
          "{username}/gatekeeper/users/{user_id}",
          "{username}/gatekeeper/orgs",
          "{username}/gatekeeper/teams"
        ]
      },
      {
        "grant_on": "user",
        "actions": [
          "listTeam",
          "listOrg",
          "listUser",
          "listRole",
          "listInvite"
        ],
        "resources": [
          "{username}/gatekeeper/teams",
          "{username}/gatekeeper/orgs",
          "{username}/gatekeeper/users",
          "{username}/gatekeeper/roles",
          "{username}/gatekeeper/invites"
        ]
      },
      {
        "grant_on": "user",
        "actions": [
          "enrollTOTP",
          "confirmTOTP",
          "getMFAStatus",
          "disableTOTP"
        ],
        "resources": [
          "{username}/gatekeeper/mfa"
        ]
      },
      {
        "grant_on": "org",
        "actions": [
          "getOrg",
          "updateOrg",
          "deleteOrg",
          "inviteUser"
        ],
        "resources": [
          "{username}/gatekeeper/orgs/{org_id}"
        ]
      },
      {
        "grant_on": "team",
        "actions": [
          "getTeam",
          "updateTeam",
          "deleteTeam",
          "inviteUser"
        ],
        "resources": [
          "{username}/gatekeeper/teams/{team_id}"
        ]
      }
    ]
  },
  {
    "name": "builder",
    "url": "http://builder:8095",
    "description": "Global service control plane (system admin only; manages the single global service baseline for the whole instance)",
    "forward_auth": true,
    "service_key": "builder-registry-local-secret",
    "endpoints": [
      {
        "method": "GET",
        "path": "/services",
        "action": "listOrgServices",
        "resource": "builder/orgs/default"
      },
      {
        "method": "GET",
        "path": "/services/{service}",
        "action": "getOrgService",
        "resource": "builder/orgs/default"
      },
      {
        "method": "PUT",
        "path": "/services/{service}",
        "action": "configureOrgService",
        "resource": "builder/orgs/default"
      },
      {
        "method": "DELETE",
        "path": "/services/{service}",
        "action": "deleteOrgService",
        "resource": "builder/orgs/default"
      }
    ],
    "actions": [],
    "default_grants": []
  }
]
