[
  {
    "name": "gatekeeper",
    "url": "http://gatekeeper:8081",
    "description": "Authentication, authorisation and user management",
    "forward_auth": true,
    "service_key": "gatekeeper-registry-local-secret",
    "endpoints": [
      {
        "method": "GET",
        "path": "/.well-known/openid-configuration",
        "action": "oidcDiscovery",
        "resource": "gatekeeper/oidc",
        "public": true
      },
      {
        "method": "GET",
        "path": "/oauth/jwks",
        "action": "oidcJWKS",
        "resource": "gatekeeper/oidc",
        "public": true
      },
      {
        "method": "GET",
        "path": "/oauth/authorize",
        "action": "oidcAuthorize",
        "resource": "gatekeeper/oidc",
        "public": true
      },
      {
        "method": "POST",
        "path": "/oauth/authorize",
        "action": "oidcAuthorize",
        "resource": "gatekeeper/oidc",
        "public": true
      },
      {
        "method": "POST",
        "path": "/oauth/token",
        "action": "oidcToken",
        "resource": "gatekeeper/oidc",
        "public": true
      },
      {
        "method": "GET",
        "path": "/oauth/userinfo",
        "action": "oidcUserinfo",
        "resource": "gatekeeper/oidc",
        "public": true
      },
      {
        "method": "GET",
        "path": "/setup/status",
        "action": "setupStatus",
        "resource": "gatekeeper/setup",
        "public": true
      },
      {
        "method": "POST",
        "path": "/signup",
        "action": "signup",
        "resource": "gatekeeper/users",
        "public": true
      },
      {
        "method": "POST",
        "path": "/login",
        "action": "login",
        "resource": "gatekeeper/users",
        "public": true
      },
      {
        "method": "GET",
        "path": "/users",
        "action": "listUser",
        "resource": "gatekeeper/users"
      },
      {
        "method": "GET",
        "path": "/users/{id}",
        "action": "getUser",
        "resource": "gatekeeper/users/{id}"
      },
      {
        "method": "PUT",
        "path": "/users/{id}",
        "action": "updateUser",
        "resource": "gatekeeper/users/{id}"
      },
      {
        "method": "DELETE",
        "path": "/users/{id}",
        "action": "deleteUser",
        "resource": "gatekeeper/users/{id}"
      },
      {
        "method": "GET",
        "path": "/orgs",
        "action": "listOrg",
        "resource": "gatekeeper/orgs"
      },
      {
        "method": "POST",
        "path": "/orgs",
        "action": "createOrg",
        "resource": "gatekeeper/orgs"
      },
      {
        "method": "GET",
        "path": "/orgs/{id}",
        "action": "getOrg",
        "resource": "gatekeeper/orgs/{id}"
      },
      {
        "method": "PUT",
        "path": "/orgs/{id}",
        "action": "updateOrg",
        "resource": "gatekeeper/orgs/{id}"
      },
      {
        "method": "DELETE",
        "path": "/orgs/{id}",
        "action": "deleteOrg",
        "resource": "gatekeeper/orgs/{id}"
      },
      {
        "method": "GET",
        "path": "/teams",
        "action": "listTeam",
        "resource": "gatekeeper/teams"
      },
      {
        "method": "POST",
        "path": "/teams",
        "action": "createTeam",
        "resource": "gatekeeper/teams"
      },
      {
        "method": "GET",
        "path": "/teams/{id}",
        "action": "getTeam",
        "resource": "gatekeeper/teams/{id}"
      },
      {
        "method": "PUT",
        "path": "/teams/{id}",
        "action": "updateTeam",
        "resource": "gatekeeper/teams/{id}"
      },
      {
        "method": "DELETE",
        "path": "/teams/{id}",
        "action": "deleteTeam",
        "resource": "gatekeeper/teams/{id}"
      },
      {
        "method": "POST",
        "path": "/roles",
        "action": "createRole",
        "resource": "gatekeeper/roles"
      },
      {
        "method": "GET",
        "path": "/roles",
        "action": "listRole",
        "resource": "gatekeeper/roles"
      },
      {
        "method": "GET",
        "path": "/roles/{id}",
        "action": "getRole",
        "resource": "gatekeeper/roles/{id}"
      },
      {
        "method": "PUT",
        "path": "/roles/{id}",
        "action": "updateRole",
        "resource": "gatekeeper/roles/{id}"
      },
      {
        "method": "DELETE",
        "path": "/roles/{id}",
        "action": "deleteRole",
        "resource": "gatekeeper/roles/{id}"
      },
      {
        "method": "POST",
        "path": "/permissions",
        "action": "createPermission",
        "resource": "gatekeeper/permissions"
      },
      {
        "method": "GET",
        "path": "/permissions/{id}",
        "action": "getPermission",
        "resource": "gatekeeper/permissions/{id}"
      },
      {
        "method": "PUT",
        "path": "/permissions/{id}",
        "action": "updatePermission",
        "resource": "gatekeeper/permissions/{id}"
      },
      {
        "method": "DELETE",
        "path": "/permissions/{id}",
        "action": "deletePermission",
        "resource": "gatekeeper/permissions/{id}"
      },
      {
        "method": "GET",
        "path": "/sessions/{id}",
        "action": "getSession",
        "resource": "gatekeeper/sessions/{id}"
      },
      {
        "method": "DELETE",
        "path": "/sessions/{id}",
        "action": "deleteSession",
        "resource": "gatekeeper/sessions/{id}"
      },
      {
        "method": "GET",
        "path": "/invites",
        "action": "listInvite",
        "resource": "gatekeeper/invites"
      },
      {
        "method": "GET",
        "path": "/invites/{id}",
        "action": "getInvite",
        "resource": "gatekeeper/invites/{id}"
      },
      {
        "method": "DELETE",
        "path": "/invites/{id}",
        "action": "deleteInvite",
        "resource": "gatekeeper/invites/{id}"
      },
      {
        "method": "POST",
        "path": "/orgs/{id}/invites",
        "action": "inviteUser",
        "resource": "gatekeeper/orgs/{id}"
      },
      {
        "method": "POST",
        "path": "/teams/{id}/invites",
        "action": "inviteUser",
        "resource": "gatekeeper/teams/{id}"
      },
      {
        "method": "POST",
        "path": "/invites/{id}/accept",
        "action": "acceptInvite",
        "resource": "gatekeeper/invites/{id}"
      },
      {
        "method": "POST",
        "path": "/invites/{id}/decline",
        "action": "declineInvite",
