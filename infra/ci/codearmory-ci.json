{
  "name": "codearmory-ci",
  "description": "dogfood CI: checkout -> [build+test per module] -> image builds, with a gocache that persists across runs",
  "steps": [
    {"action":"forge/create-volume","name":"workspace",
     "with":{"workflow_id":"${run_id}","name":"workspace","size_mb":512,"medium":"disk"}},
    {"action":"forge/create-volume","name":"gocache",
     "with":{"workflow_id":"${run_id}","name":"gocache","size_mb":4096,"medium":"disk"}},

    {"action":"forge/git-clone","name":"checkout","timeout":600,
     "with":{"run":"true","timeout":600,"checkout":{"depth":1,"ref":"dev-2"},
       "secret_refs":{"GIT_CLONE_URL":"git:http://192.168.53.171:3000/jp01/codearmory.git"},
       "volumes":[{"workflow_id":"${run_id}","name":"workspace","mount_path":"/workspace","workdir":true}]}},

    {"action":"forge/restore-artifact","name":"restore-gocache","timeout":900,
     "with":{"runner_class":"ci","timeout":900,
       "volumes":[{"workflow_id":"${run_id}","name":"gocache","mount_path":"/gocache","workdir":true}],
       "artifact":{"mode":"restore","name":"codearmory-gocache","path":".","optional":true}}},

    {"action":"forge/run","name":"warm-cache","timeout":1800,
     "with":{"image":"golang:1.25","runner_class":"ci","timeout":1800,
       "env":{"GOCACHE":"/gocache/build","GOFLAGS":"-p=2","GOMODCACHE":"/gocache/mod"},
       "volumes":[{"workflow_id":"${run_id}","name":"workspace","mount_path":"/workspace","workdir":true},
                  {"workflow_id":"${run_id}","name":"gocache","mount_path":"/gocache"}],
       "run":"set -eu\nmkdir -p /gocache/mod /gocache/build\ncd /workspace/src/systems\nfor d in $(go list -m -f '{{.Dir}}'); do ( cd \"$d\" && go mod download ); done\n( cd /workspace/src/cli && go mod download )\necho '=== module cache primed ==='\ndu -sh /gocache/mod\n"}},

    {"action":"forge/run","name":"discover","timeout":120,
     "with":{"image":"golang:1.25","runner_class":"standard","timeout":120,"output_env":["MODULES"],
       "volumes":[{"workflow_id":"${run_id}","name":"workspace","mount_path":"/workspace"}],
       "run":"set -eu\ncd /workspace/src\nMODULES=\"\"\nfor f in systems/*/go.mod cli/go.mod; do [ -f \"$f\" ] || continue; MODULES=\"$MODULES ${f%/go.mod}\"; done\nMODULES=\"${MODULES# }\"\necho \"modules: $MODULES\"\n"}},

    {"action":"forge/run","name":"build","map_id":"per-module","timeout":2400,
     "with":{"image":"golang:1.25","runner_class":"ci","timeout":2400,
       "env":{"GOCACHE":"/gocache/build","GOFLAGS":"-p=2","GOMODCACHE":"/gocache/mod"},
       "volumes":[{"workflow_id":"${run_id}","name":"gocache","mount_path":"/gocache"}],
       "run":"set -eu\ncd \"/workspace/src/${map.module}\"\necho \"=== build ${map.module} ===\"\ngo build ./...\n"}},

    {"action":"forge/run","name":"test","map_id":"per-module","timeout":2400,
     "with":{"image":"golang:1.25","runner_class":"ci","timeout":2400,
       "env":{"GOCACHE":"/gocache/build","GOFLAGS":"-p=2","GOMODCACHE":"/gocache/mod"},
       "volumes":[{"workflow_id":"${run_id}","name":"gocache","mount_path":"/gocache"}],
       "run":"set -eu\ncd \"/workspace/src/${map.module}\"\necho \"=== test ${map.module} ===\"\ngo test ./...\n"}},

    {"action":"forge/save-artifact","name":"save-gocache","timeout":900,
     "with":{"runner_class":"ci","timeout":900,
       "volumes":[{"workflow_id":"${run_id}","name":"gocache","mount_path":"/gocache","workdir":true}],
       "artifact":{"mode":"save","name":"codearmory-gocache","path":"mod"}}},

    {"action":"forge/build-image","name":"image","timeout":2400,
     "with":{"runner_class":"ci","timeout":2400,
       "volumes":[{"workflow_id":"${run_id}","name":"workspace","mount_path":"/workspace"}],
       "build":{"context":"/workspace/src/systems/${matrix.svc}","dockerfile":"Dockerfile",
                "destinations":["ghcr.io/code-armory-app/${matrix.svc}:ci"],"no_push":true}},
     "matrix":{"var":"svc","values":["gatekeeper","registry","conductor","workflows","forge","builder","tickets","containers","git","hooks","egress-proxy","outpost-gateway"],"max_concurrent":2}}
  ],
  "maps":[{"id":"per-module","var":"module","values_from":"${steps.discover.output.MODULES}",
           "volume":"workspace","mount_path":"/workspace","size_mb":512,"medium":"disk","max_concurrent":4}],
  "routes":[
    {"from":"workspace","to":"checkout"},
    {"from":"gocache","to":"restore-gocache"},
    {"from":"checkout","to":"warm-cache"},
    {"from":"restore-gocache","to":"warm-cache"},
    {"from":"warm-cache","to":"discover"},
    {"from":"discover","to":"build"},
    {"from":"build","to":"test"},
    {"from":"test","to":"save-gocache"},
    {"from":"test","to":"image"}
  ]
}
